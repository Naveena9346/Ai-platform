# NexusAI Platform - Environment Configuration Example

# System Settings
PROJECT_NAME="NexusAI Enterprise Platform"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="nexus_ai_super_secret_enterprise_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER="nexus_admin"
POSTGRES_PASSWORD="nexus_password_123"
POSTGRES_DB="nexus_ai_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://nexus_admin:nexus_password_123@localhost:5432/nexus_ai_db"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# AI Provider API Keys Configuration
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
HUGGINGFACE_API_KEY=""
COHERE_API_KEY=""
MISTRAL_API_KEY=""

# Storage Configuration
STORAGE_TYPE="local" # local or s3
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=50

# Gamification Settings
DEFAULT_XP_MULTIPLIER=1.0
STREAK_BONUS_MULTIPLIER=1.5
